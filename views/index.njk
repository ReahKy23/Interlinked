<link rel="stylesheet" href="/css/space.css" />
{% endblock %} #}

{% block content %}

{# Div for animation if added
<div class="logo-container"> #}
  <div class="welcome">
    <h1> I N T E R L I N K E D </h1>
  </div>
  {#
</div> #}



{# Using img tag instead of background-url in CSS to keep the image fixed #}

<img class="bg" src="/assets/base-bg.png">



<div class="buttons">

  <button class="form-button"><a href="/form">C O N T R I B U T E</a></button>

  <button class="map-button"><a href="/map">E X P L O R E</a></button>

</div>

<div class="comp-popup" onclick="openPopup()">
  <img class="computer-off" src="/assets/Computer.png" />
  <img class="computer-on" src="/assets/Computer.gif" />
</div>

<div id="popup" class="popup hidden">
  <div class="popup-text">
    <span class="close" onclick="closePopup()">✖</span>
    <p id="blurb">
      I am Motha. I was on an expidition with my crew when the ship went down. Where am I? <u></u>When am I? I am so lost. I am so alone. If I don't have a crew to serve, what is my purpose? What is my meaning? Help me. Help me be human...
    </p>
    <p id="blurb"> Click 'next' to proceed to the fillout form.<span style="margin-right: 200px;"></span><a class="next"
        href="/form">Next</a> </p>
  </div>
</div>

{% endblock %}

{% block scripts %}
<script src="/scripts/popup.js"></script>
{% endblock %}